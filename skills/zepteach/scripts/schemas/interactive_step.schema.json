{
  "$id": "interactive_step", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "interaction_id", "learning_thread_id", "lab_id", "part_id", "title", "prompt", "prediction_fields"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "interaction_id": {"type": "string", "minLength": 1},
    "learning_thread_id": {"type": "string", "minLength": 1},
    "lab_id": {"type": "string", "minLength": 1},
    "part_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "collect_confidence": {"type": "boolean"},
    "acknowledged_event_ids": {"type": "array", "items": {"type": "string"}},
    "prediction_fields": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["field_id", "label", "kind"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["numeric", "text", "choice"]},
        "min": {"type": "number"}, "max": {"type": "number"}, "step": {"type": "number", "minimum": 0.000001},
        "options": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["value", "label"], "properties": {"value": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
        }}
      }
    }}
  }
}
